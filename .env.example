# Salin fail ini kepada ".env" dan isi nilai sebenar.
# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Gunakan "service_role" key (RAHSIA - jangan letak dalam frontend / jangan commit ke Git)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

PORT=3000

# Pilihan tetapi DISARANKAN jika sistem boleh dicapai dari internet:
# log masuk asas (HTTP Basic Auth) untuk seluruh aplikasi
APP_USER=
APP_PASSWORD=
