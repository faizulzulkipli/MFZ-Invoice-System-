# TIDAK WAJIB. Cara biasa: jalankan "node server.js" dan ikut halaman setup kali pertama.
# Isi di sini hanya jika anda mahu tetapkan melalui environment (cth. hosting Render / Docker).
# Environment diutamakan berbanding data/config.json.

# Supabase Dashboard > Project Settings > API
#SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Kunci "service_role" (RAHSIA - jangan commit ke Git). Bukan kunci anon / publishable.
#SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

PORT=3000

# Pilihan (cara lama): jika kedua-duanya diisi, ia menjadi akaun admin dan langkah cipta admin di setup dilangkau.
#APP_USER=
#APP_PASSWORD=
